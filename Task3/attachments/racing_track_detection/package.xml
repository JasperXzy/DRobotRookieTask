<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racing_track_detection</name>
  <version>3.0.0</version>
  <description>X5 BPU track-center detection with Foxglove ImageAnnotations.</description>
  <maintainer email="jasper.zhengyi.xu@gmail.com">Jasper Xu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ai_msgs</depend>
  <depend>dnn_node</depend>
  <depend>foxglove_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>hbm_img_msgs</depend>
  <depend>hobot_cv</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
